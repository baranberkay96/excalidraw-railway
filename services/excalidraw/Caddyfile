# Excalidraw gateway: the only public entry.
#   /_gateway/health  -> Railway healthcheck (no auth)
#   /socket.io/*      -> Excalidraw Room (live collaboration), behind the same password
#   everything else   -> the Excalidraw web app (static files)
{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:8080} {
	handle /_gateway/health {
		respond "ok" 200
	}

	# Browsers send cached basic-auth credentials on cross-site requests and
	# WebSockets too; only this site's own pages may call it.
	@cross_site {
		header Origin *
		not header Origin https://{host}
	}
	handle @cross_site {
		respond "Cross-origin request refused" 403
	}

	handle {
		import /etc/caddy/auth.caddy
		header -Server
		header X-Robots-Tag "noindex, nofollow"

		handle /socket.io/* {
			reverse_proxy {$ROOM_UPSTREAM} {
				flush_interval -1
				lb_try_duration 20s
				lb_try_interval 1s
			}
		}
		handle {
			root * /srv/excalidraw
			encode zstd gzip
			@immutable path /assets/*
			header @immutable Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}
	}
}
